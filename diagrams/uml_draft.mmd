classDiagram
    %% PawPal+ initial design (Phase 1 draft) - written before any code.
    %% See uml_final.mmd / uml.mmd for the diagram that matches the final implementation.

    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet)
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task)
        +get_tasks() list~Task~
    }

    class Task {
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +bool completed
        +mark_complete()
    }

    class Scheduler {
        +Owner owner
        +sort_by_time() list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +detect_conflicts() list~str~
        +generate_daily_plan() list~Task~
    }

    Owner "1" o-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads tasks via get_all_tasks()
